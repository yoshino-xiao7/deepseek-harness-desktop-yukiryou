{
  "name": "deepseek-harness-desktop-yukiryou",
  "productName": "DeepSeek YukiRyou",
  "version": "1.0.1",
  "description": "An independent DeepSeek Harness desktop workspace for macOS and Windows",
  "author": "YukiRyou <https://github.com/yoshino-xiao7>",
  "homepage": "https://github.com/yoshino-xiao7/deepseek-harness-desktop-yukiryou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshino-xiao7/deepseek-harness-desktop-yukiryou.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": ".vite/build/main-entry.cjs",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "app-builder-bin",
      "fs-xattr",
      "macos-alias"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@electron/osx-sign@1.3.3": "patches/@electron__osx-sign@1.3.3.patch"
    }
  },
  "scripts": {
    "dev": "electron-forge start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:stress": "DSH_STRESS_CYCLES=100 vitest run tests/integration/runtime-stress.test.ts",
    "test:soak": "DSH_SOAK_DURATION_MS=28800000 vitest run tests/integration/runtime-soak.test.ts",
    "test:memory": "DSH_MEMORY_CYCLES=2500 vitest run tests/performance/companion-memory.test.ts",
    "test:upgrade": "vitest run tests/release/previous-version-upgrade.test.ts",
    "test:soak:app": "DSH_PACKAGED_SOAK_DURATION_MS=60000 vitest run tests/performance/packaged-app-soak.test.ts",
    "test:soak:app:release": "DSH_PACKAGED_SOAK_DURATION_MS=1800000 vitest run tests/performance/packaged-app-soak.test.ts",
    "test:soak:app:extended": "DSH_PACKAGED_SOAK_DURATION_MS=18000000 vitest run tests/performance/packaged-app-soak.test.ts",
    "test:e2e": "vitest run tests/e2e --no-file-parallelism",
    "test:watch": "vitest",
    "runtime:vendor": "node scripts/vendor-runtime.ts",
    "runtime:vendor:win": "node scripts/vendor-runtime.ts --platform=win32 --arch=x64",
    "runtime:verify": "node scripts/verify-runtime.ts",
    "release:mac:candidate": "node scripts/prepare-release-candidate.ts",
    "release:win:candidate": "node scripts/prepare-windows-candidate.ts",
    "release:mac": "node scripts/release-macos.ts",
    "release:mac:finish": "node scripts/release-macos.ts --finish",
    "verify:distribution": "node scripts/verify-distribution.ts",
    "verify:release": "node scripts/verify-release.ts",
    "package:mac": "electron-forge package --platform=darwin",
    "make:mac": "electron-forge make --platform=darwin",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "make:win": "electron-forge make --platform=win32 --arch=x64 && electron-builder --win nsis --x64 --prepackaged \"out/DeepSeek YukiRyou-win32-x64\" --publish never",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.0.12",
    "eslint": "10.8.1",
    "playwright": "1.62.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "yaml": "2.9.0"
  }
}
